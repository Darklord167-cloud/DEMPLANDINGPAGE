rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Validates if an ID is generally sane
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    match /users/{userId}/private/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId && isValidId(document);
    }
    
    match /bot_states/{botId} {
      // Read access restricted to document owner
      allow read: if request.auth != null && isValidId(botId) && resource.data.userId == request.auth.uid;

      // Create access requires specifying matching userId
      allow create: if request.auth != null 
                    && isValidId(botId) 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['status', 'userId']);

      // Update and delete operations strictly restricted to document owner
      allow update, delete: if request.auth != null 
                            && isValidId(botId) 
                            && resource.data.userId == request.auth.uid;
    }
  }
}
